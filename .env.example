# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5

# Look up beer ABV on the web when a post names a beer but doesn't show its ABV.
# Needs web search enabled in Console → Settings → Privacy/Features. Each beer is searched once.
BEER_LOOKUP=on
LOOKUP_MODEL=claude-haiku-5-5

# Leave empty on first listener run; it prints your groups' IDs.
PINT_GROUP_JID=
MY_NAME=Srinjay

# Pick a long random topic name: anyone who knows it can read the notifications.
NTFY_TOPIC=pintbot-change-me-to-something-random

GOAL_DEADLINE=2036-12-31
LOW_ABV_BEER_POINTS=0.5
